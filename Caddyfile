:80 {
    log {
        output file /var/log/caddy/access.log
    }

    # 🚨 INJECTING CORE INTERCEPTION STRAINS
    coraza_waf {
        directive "Include /etc/coraza/coraza.conf-recommended"
        directive "SecRuleEngine On"
        directive "SecDebugLog /dev/stdout"
        directive "SecDebugLogLevel 3"
        # Immediate block rules targeting standard exploitation strings
        directive "SecRule ARGS \"(UNION SELECT|SELECT.*FROM|<script>)\" \"id:100001,phase:2,deny,status:403,log,msg:'🏛️ NEXUS CITADEL ACTIVE INTRUSION DROP'\""
    }

    reverse_proxy nginx-edge-proxy:80
}
